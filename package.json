{
  "name": "torollo",
  "version": "1.2.4",
  "description": "Local-first system design lab: every node on the canvas is a real Docker container, and guided roadmaps grade each step against the live state of your system.",
  "keywords": [
    "system-design",
    "docker",
    "backend",
    "architecture",
    "networking",
    "roadmaps",
    "learning",
    "lab",
    "simulator",
    "education",
    "devops"
  ],
  "homepage": "https://torollo.app",
  "author": "Youssef",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Derssa/torollo.git"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": "bin/cli.js",
  "scripts": {
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "prepack": "npm run build",
    "start": "node ./bin/cli.js start",
    "test": "node --test bin/lib/dockerHost.test.js bin/lib/diagnostics.test.js bin/lib/backendHealth.test.js bin/lib/progress.test.js bin/lib/doctor.test.js"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "ajv": "^8.20.0",
    "cors": "^2.8.6",
    "dockerode": "^5.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "serve": "^14.2.4",
    "socket.io": "^4.8.3"
  },
  "files": [
    "README.md",
    "assets/**/*",
    "bin/**/*",
    "!bin/**/*.test.js",
    "backend/dist/**/*",
    "!backend/dist/**/*.test.js",
    "!backend/dist/**/*.itest.js",
    "!backend/dist/**/testSupport.js",
    "frontend/dist/**/*",
    "roadmaps/**/*"
  ]
}
